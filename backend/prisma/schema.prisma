// Travel Agency CRM — Prisma schema (Phase 1)
//
// Multi-tenant rules (PROJECT_SPEC.md §4):
//   - Every client-data table has an organization_id FK.
//   - Row Level Security is enabled + FORCED on every client-data table.
//     The RLS policies live in the migration SQL (Postgres feature, not
//     representable in this schema) — see prisma/migrations/*/migration.sql.
//
// `datasource.url` = DATABASE_URL (privileged) is used for migrations and the
// narrow auth surface (systemPrisma). The runtime tenant client connects with
// APP_DATABASE_URL (restricted `crm_app` role) so RLS is enforced. See
// src/lib/prisma.ts.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// --- Phase 2 enums ---------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  CALL
  MEETING
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum BillCategory {
  HOTEL
  FLIGHT
  TRANSPORT
  ACTIVITY
  VISA
  FOOD
  OTHER
}

enum BillStatus {
  UNPAID
  PAID
}

// --- Phase 3 enums (Communication) ------------------------------------------

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  EMAIL
}

enum ChannelConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  FAILED
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommChannel {
  EMAIL
}

enum CommStatus {
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A travel agency (tenant). Every other client-data row is scoped to one of these.
model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  slug                String             @unique
  // Platform-owner control (Super Admin panel) — a SUSPENDED org's users can no
  // longer log in or refresh their session; their data is untouched. Set only
  // via the platform-admin surface, never by an org's own admin.
  status              OrganizationStatus @default(ACTIVE)
  suspendedAt         DateTime?          @map("suspended_at")
  suspendedReason     String?            @map("suspended_reason")
  logoUrl             String?
  brandPrimaryColor   String   @default("#4F46E5") @map("brand_primary_color")
  brandSecondaryColor String   @default("#0D9488") @map("brand_secondary_color")
  bio                 String?
  hostLinks           Json     @default("[]") @map("host_links")
  // --- Host Page mini-website ---
  bannerImageUrl      String?  @map("banner_image_url")
  aboutText           String?  @map("about_text")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  address             String?
  linktreeCoverUrl    String?  @map("linktree_cover_url")
  /// LinkTree module theme (logo, bio, contacts, background, fonts) — separate
  /// from Host Page branding by design.
  linktreeTheme       Json     @default("{}") @map("linktree_theme")
  hostGallery         Json     @default("[]") @map("host_gallery") // Host Page gallery image URLs
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users       User[]
  leads       Lead[]
  invitations Invitation[]
  hotels      Hotel[]
  packages    Package[]
  bookings    Booking[]
  itineraryItems ItineraryItem[]
  tasks       Task[]
  events      Event[]
  invoices    Invoice[]
  bills       Bill[]
  leadActivities LeadActivity[]
  sightseeing Sightseeing[]
  batches     Batch[]
  linktreeCategories LinktreeCategory[]
  packageLinktreeCategories PackageLinktreeCategory[]
  hostReviews HostReview[]
  channelConnections ChannelConnection[]
  conversations      Conversation[]
  messages           Message[]
  messageTemplates   MessageTemplate[]
  communicationLogs  CommunicationLog[]
  botFlows           BotFlow[]
  botFlowSteps       BotFlowStep[]
  botFlowAssignments BotFlowAssignment[]
  botFlowSessions    BotFlowSession[]
  aiAgentSettings    AiAgentSettings?
  automationSettings AutomationSettings?
  followUpAttempts   FollowUpAttempt[]

  @@map("organizations")
}

/// Reusable activity library. Simplified to just name + cover image + description.
/// These entries are a *content source*: picking one copies its values into a
/// package day (see PackageBuilder). Kept flat + searchable by name/description
/// so a future AI itinerary generator can query them.
model Sightseeing {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  imageUrl       String?  @map("image_url") // cover image (optional)
  notes          String? // description
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sightseeing")
}

/// A customer review shown on the Host Page mini-website. Manually added by the
/// agency (not linked to bookings).
model HostReview {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  reviewerName   String   @map("reviewer_name")
  photoUrl       String?  @map("photo_url")
  quote          String
  rating         Int? // 1-5, optional
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, sortOrder])
  @@map("host_reviews")
}

/// LinkTree-specific category (per-org). Orders the tabs on the public
/// LinkTree page. Standalone — unrelated to the free-text Package.categories tags.
model LinktreeCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packages     PackageLinktreeCategory[]

  @@index([organizationId])
  @@index([organizationId, sortOrder])
  @@map("linktree_categories")
}

/// Many-to-many: a package can sit in several LinkTree categories.
/// Carries organization_id so RLS scopes it like every other client table.
model PackageLinktreeCategory {
  organizationId     String @map("organization_id") @db.Uuid
  packageId          String @map("package_id") @db.Uuid
  linktreeCategoryId String @map("linktree_category_id") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category     LinktreeCategory @relation(fields: [linktreeCategoryId], references: [id], onDelete: Cascade)

  @@id([packageId, linktreeCategoryId])
  @@index([organizationId])
  @@index([linktreeCategoryId])
  @@map("package_linktree_categories")
}

/// A member of an organization. ADMINs manage the org + team; AGENTs work leads.
model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String     @unique
  name           String
  passwordHash   String     @map("password_hash")
  role           Role       @default(AGENT)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  // Optional public profile, shown on the Host Page only when featured.
  featureOnHostpage Boolean @default(false) @map("feature_on_hostpage")
  publicPhotoUrl String?    @map("public_photo_url")
  publicTitle    String?    @map("public_title")
  publicBio      String?    @map("public_bio")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads   Lead[]       @relation("AssignedAgent")
  invitationsSent Invitation[] @relation("Inviter")
  bookings        Booking[]    @relation("BookingAgent")
  tasks           Task[]       @relation("TaskAssignee")
  leadActivities  LeadActivity[] @relation("ActivityAuthor")
  sentMessages       Message[]          @relation("MessageSender")
  sentCommunications CommunicationLog[] @relation("CommSender")

  @@index([organizationId])
  @@map("users")
}

/// An enquiry / prospective customer for a travel agency.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  source         LeadSource @default(MANUAL)
  status         LeadStatus @default(NEW)
  destination    String?
  travelDate     DateTime?  @map("travel_date") @db.Date
  travelerCount  Int?       @map("traveler_count")
  budgetAmount   Int?       @map("budget_amount") // whole units of budgetCurrency
  budgetCurrency String?    @default("USD") @map("budget_currency")
  notes          String?
  assignedToId   String?    @map("assigned_to_id") @db.Uuid
  // Phase 4 (Bot Flow) — set when an inbound message matches a flow's
  // "Needs Review" keyword list; the bot stops and hands off to a human.
  needsReview       Boolean  @default(false) @map("needs_review")
  needsReviewReason String?  @map("needs_review_reason")
  // Set at creation time if this lead's phone/email matches an existing
  // Booking in the org — surfaces repeat customers immediately instead of
  // treating them as a stranger (checked once, at creation; not re-checked
  // if a booking is added later, since the lead's own thread already has
  // the agent's attention by then).
  isRepeatCustomer Boolean @default(false) @map("is_repeat_customer")
  repeatBookingId  String? @map("repeat_booking_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  repeatBooking Booking?    @relation("RepeatCustomerLead", fields: [repeatBookingId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  tasks        Task[]
  activities   LeadActivity[]
  // Phase 3 (Communication) — inbound channel messages/sends land against a lead.
  // Purely additive back-relations; no column added to `leads` itself.
  conversations     Conversation[]
  communicationLogs CommunicationLog[]
  // Phase 4 (Automation) — same additive-back-relation pattern as Phase 3 above.
  followUpAttempts  FollowUpAttempt[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([assignedToId])
  @@index([repeatBookingId])
  @@map("leads")
}

/// Interaction timeline for a lead: logged calls/notes/WhatsApp touches plus
/// automatic stage-change entries. Powers the Lead Activity Board.
model LeadActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  type           LeadActivityType @default(NOTE)
  outcome        String? // e.g. "Answered", "Call not picked"
  message        String?
  fromStatus     LeadStatus? @map("from_status")
  toStatus       LeadStatus? @map("to_status")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ActivityAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

enum LeadActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  STATUS_CHANGE
}

/// Pending invitation for a new team member. Only the token HASH is stored.
model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           Role             @default(AGENT)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invitations")
}

// ===========================================================================
// Phase 2 — Core CRM
// ===========================================================================

/// Partner hotel in the agency's directory.
model Hotel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  city           String
  address        String?
  starRating     Int      @default(3) @map("star_rating")
  phone          String?
  email          String?
  pricePerNight  Int?     @map("price_per_night")
  currency       String   @default("INR")
  notes          String?
  images         Json     @default("[]") // photo URLs (Supabase Storage)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("hotels")
}

/// Reusable trip template ("Bali 5N/6D — ₹49,999").
model Package {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  destination    String
  nights         Int     @default(1)
  days           Int     @default(2)
  priceAmount    Int     @map("price_amount")
  priceCurrency  String  @default("INR") @map("price_currency")
  description    String?
  inclusions     String?
  exclusions     String?
  isActive       Boolean @default(true) @map("is_active")
  showOnLinktree Boolean @default(false) @map("show_on_linktree")
  showOnHostpage Boolean @default(false) @map("show_on_hostpage")
  pdfTemplateId  String  @default("signature") @map("pdf_template_id") // fixed — single "Signature" PDF design for every package

  // --- Premium builder fields (Basics) ---
  code                String? // package code, auto-generated if blank
  slug                String? // public URL slug
  viewType            String  @default("CLASSIC") @map("view_type")
  categories          Json    @default("[]") // string[]
  bookingTitle        String? @map("booking_title")
  originalPrice       Int?    @map("original_price") // strike-through / discount
  pricingOptions      Json    @default("[]") @map("pricing_options") // {label, price}[]
  bannerImageUrl      String? @map("banner_image_url")
  whatsappBannerUrl   String? @map("whatsapp_banner_url")
  whatsappDescription String? @map("whatsapp_description")
  contactNumber       String? @map("contact_number")
  contactEmail        String? @map("contact_email")

  // --- Itinerary / logistics / policies / faqs / extras ---
  itinerary          Json    @default("[]") // {day, title, description}[]
  thingsToCarry      String? @map("things_to_carry")
  pickupPoints       String? @map("pickup_points")
  cancellationPolicy String? @map("cancellation_policy")
  paymentTerms       String? @map("payment_terms")
  termsConditions    String? @map("terms_conditions")
  faqs               Json    @default("[]") // {question, answer}[]
  highlights         Json    @default("[]") // string[]
  galleryImages      Json    @default("[]") @map("gallery_images") // string[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  batches      Batch[]
  linktreeCategoryLinks PackageLinktreeCategory[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("packages")
}

/// A dated departure ("Event") of a package: a fixed date + seat capacity that
/// customers book onto. One package can have unlimited departures. Powers the
/// Events board and the Manage Departure page.
model Batch {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  packageId         String      @map("package_id") @db.Uuid
  name              String? // optional event/batch label e.g. "Independence Day Special"
  departureDate     DateTime    @map("departure_date") @db.Date
  returnDate        DateTime?   @map("return_date") @db.Date
  bookingCloseDate  DateTime?   @map("booking_close_date") @db.Date
  capacity          Int         @default(20) // total seats
  pricePerPerson    Int?        @map("price_per_person") // defaults to package price when null
  pickupCity        String?     @map("pickup_city")
  coverImageOverride String?    @map("cover_image_override")
  status            EventStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId])
  @@index([packageId, departureDate])
  @@map("batches")
}

enum EventStatus {
  DRAFT
  LIVE
  COMPLETED
  CANCELLED
}

/// A confirmed (or in-progress) trip for a customer. BK-#### per organization.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  bookingNumber  Int           @map("booking_number")
  customerName   String        @map("customer_name")
  customerEmail  String?       @map("customer_email")
  customerPhone  String?       @map("customer_phone")
  destination    String
  startDate      DateTime?     @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  travelerCount  Int?          @map("traveler_count")
  status         BookingStatus @default(PENDING)
  totalAmount    Int           @default(0) @map("total_amount")
  amountPaid     Int           @default(0) @map("amount_paid")
  currency       String        @default("INR")
  notes          String?
  leadId         String?       @map("lead_id") @db.Uuid
  packageId      String?       @map("package_id") @db.Uuid
  batchId        String?       @map("batch_id") @db.Uuid
  assignedToId   String?       @map("assigned_to_id") @db.Uuid
  // True when this booking was created automatically (a Lead was marked WON)
  // rather than through the manual "Convert to booking" action — surfaced in
  // the UI so staff understand where it came from.
  autoCreated    Boolean       @default(false) @map("auto_created")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  package        Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  batch          Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  assignedTo     User?           @relation("BookingAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  itineraryItems ItineraryItem[]
  tasks          Task[]
  invoices       Invoice[]
  bills          Bill[]
  // Additive back-relation for Lead.repeatBookingId — same pattern already
  // used throughout (Phase 3/4 relations onto Lead).
  repeatCustomerLeads Lead[] @relation("RepeatCustomerLead")

  @@unique([organizationId, bookingNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
  @@map("bookings")
}

/// One day (or item) of a booking's itinerary.
model ItineraryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  dayNumber      Int      @map("day_number")
  title          String
  subtitle       String? // "what's happening" one-liner
  city           String?
  country        String?
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingId, dayNumber])
  @@map("itinerary_items")
}

/// Scheduler entry / follow-up reminder — optionally linked to a lead or booking.
model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String
  notes          String?
  type           TaskType   @default(FOLLOW_UP)
  status         TaskStatus @default(PENDING)
  dueAt          DateTime   @map("due_at")
  leadId         String?    @map("lead_id") @db.Uuid
  bookingId      String?    @map("booking_id") @db.Uuid
  assignedToId   String?    @map("assigned_to_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status, dueAt])
  @@index([leadId])
  @@index([bookingId])
  @@map("tasks")
}

/// Manual calendar entry (the departure calendar also merges bookings + tasks).
model Event {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  date           DateTime @db.Date
  notes          String?
  color          String   @default("#4F46E5")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("events")
}

/// Customer invoice for a booking. INV-#### per organization; line items as JSON.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceNumber  Int           @map("invoice_number")
  bookingId      String?       @map("booking_id") @db.Uuid
  customerName   String        @map("customer_name")
  customerEmail  String?       @map("customer_email")
  customerPhone  String?       @map("customer_phone")
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  items          Json          @default("[]")
  subtotal       Int           @default(0)
  taxPercent     Float         @default(0) @map("tax_percent")
  taxAmount      Int           @default(0) @map("tax_amount")
  total          Int           @default(0)
  currency       String        @default("INR")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([bookingId])
  @@map("invoices")
}

/// Vendor cost (hotel, flight, transport…) tracked against a booking for margin.
model Bill {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  bookingId      String?      @map("booking_id") @db.Uuid
  vendorName     String       @map("vendor_name")
  category       BillCategory @default(OTHER)
  amount         Int
  currency       String       @default("INR")
  billDate       DateTime     @default(now()) @map("bill_date") @db.Date
  status         BillStatus   @default(UNPAID)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bookingId])
  @@map("bills")
}

// ===========================================================================
// Phase 3 — Communication (WhatsApp Inbox, Instagram Inbox, Email, Calls)
// ===========================================================================
//
// Call Log deliberately has NO new table — it reuses the existing LeadActivity
// model (type=CALL, which already carries outcome/message/createdBy/leadId).
// See modules/call-log for the org-wide list view over that same data.

/// One row per organization per channel: connection status + encrypted
/// credentials. WhatsApp/Instagram store an OAuth access token (from Meta's
/// Embedded Signup / Instagram Login); Email stores a provider API key.
/// `credentials` is always encrypted at rest (see src/lib/encryption.ts) and is
/// never serialized back to the client.
model ChannelConnection {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  channel        ChannelType
  status         ChannelConnectionStatus @default(NOT_CONNECTED)
  displayName    String?                 @map("display_name") // phone number / IG handle / from-address / sender id shown in Settings
  externalId     String?                 @map("external_id") // WABA id / IG-scoped account id — routes inbound webhooks to this org
  credentials    String?                 // AES-256-GCM encrypted JSON blob
  lastError      String?                 @map("last_error")
  connectedAt    DateTime?               @map("connected_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@index([organizationId])
  @@index([channel, externalId])
  @@map("channel_connections")
}

/// One inbox thread per external contact per channel per organization. Powers
/// the unified WhatsApp/Instagram Inbox (one screen, filtered by channel tab).
model Conversation {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  channel            ConversationChannel
  externalContactId  String              @map("external_contact_id") // WhatsApp wa_id (phone) or Instagram IGSID
  contactName        String?             @map("contact_name")
  contactPhone       String?             @map("contact_phone") // WhatsApp only
  leadId             String?             @map("lead_id") @db.Uuid
  lastMessageAt      DateTime?           @map("last_message_at")
  lastMessagePreview String?             @map("last_message_preview")
  lastInboundAt      DateTime?           @map("last_inbound_at") // start of WhatsApp's 24h free-form reply window
  unreadCount        Int                 @default(0) @map("unread_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     Message[]
  // Phase 4 (Bot Flow) — additive back-relation, same pattern Phase 3 used on Lead.
  botFlowSession BotFlowSession?

  @@unique([organizationId, channel, externalContactId])
  @@index([organizationId])
  @@index([organizationId, channel, lastMessageAt])
  @@index([leadId])
  @@map("conversations")
}

/// One inbound or outbound message within a conversation.
model Message {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  conversationId     String          @map("conversation_id") @db.Uuid
  direction         MessageDirection
  externalMessageId String?          @map("external_message_id")
  body              String?
  mediaUrl          String?          @map("media_url")
  templateName      String?          @map("template_name") // set when sent as a WhatsApp template (outside the 24h window)
  status            MessageStatus    @default(SENT)
  errorMessage      String?          @map("error_message")
  sentById          String?          @map("sent_by_id") @db.Uuid // agent who sent it (outbound only)
  createdAt         DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// WhatsApp message template (needed to message a contact outside the 24h
/// window). Created against Meta and mirrored here with its approval status.
model MessageTemplate {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  name               String
  category           String         @default("UTILITY")
  language           String         @default("en_US")
  bodyText           String         @map("body_text")
  status             TemplateStatus @default(PENDING)
  externalTemplateId String?        @map("external_template_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, language])
  @@index([organizationId])
  @@map("message_templates")
}

/// Send history for Email sends against a lead (e.g. emailing a package PDF).
model CommunicationLog {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  leadId            String      @map("lead_id") @db.Uuid
  channel           CommChannel
  toAddress         String      @map("to_address") // email address or phone number
  subject           String?
  body              String
  status            CommStatus  @default(SENT)
  providerMessageId String?     @map("provider_message_id")
  errorMessage      String?     @map("error_message")
  sentById          String?     @map("sent_by_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("CommSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId, createdAt])
  @@map("communication_logs")
}

// ===========================================================================
// Phase 4 — Automation & AI (Bot Flow, AI Agent Builder, Follow-up Automation)
// ===========================================================================
//
// Cross-references Phase 3 tables (ChannelConnection, Conversation) by real FK
// with additive back-relations only — no Phase 3 module file is touched.
// Gemini gets its own encrypted-credential table (AiAgentSettings) rather than
// reusing ChannelConnection: same at-rest encryption + per-org Settings-screen
// pattern, but Gemini isn't a messaging channel with its own conversations/
// status, so it doesn't belong in that table.

enum BotFlowStepType {
  COLLECT
  CONFIRM
  CLOSING
}

enum BotFlowSessionStatus {
  ACTIVE
  COMPLETED
  NEEDS_REVIEW
}

enum FollowUpStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

/// A conversational flow an organization runs on ONE connected WhatsApp number
/// or Instagram account (see BotFlowAssignment). Steps are ordered/branching
/// nodes (see BotFlowStep); COLLECT steps write straight into the existing
/// Lead model — no parallel data store. If an inbound message matches
/// `needsReviewKeywords`, the flow engine stops and flags the Lead instead of
/// guessing (see Lead.needsReview).
model BotFlow {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  name                String
  fallbackMessage     String   @default("Sorry, I didn't quite get that — let me get a team member to help you.") @map("fallback_message")
  needsReviewKeywords Json     @default("[]") @map("needs_review_keywords") // string[]
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        BotFlowStep[]
  assignments  BotFlowAssignment[]
  sessions     BotFlowSession[]

  @@index([organizationId])
  @@map("bot_flows")
}

/// One step (node) in a BotFlow's canvas. COLLECT asks a question and writes
/// the reply into an existing Lead field. CONFIRM asks yes/no or multiple-
/// choice and branches via `options`. CLOSING sends a final message and ends
/// the flow. `canvasX`/`canvasY` persist the visual builder's node layout.
model BotFlowStep {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  flowId         String          @map("flow_id") @db.Uuid
  type           BotFlowStepType
  order          Int             @default(0)
  question       String? // COLLECT/CONFIRM prompt text, or CLOSING's final message
  leadField      String?         @map("lead_field") // COLLECT only — target Lead column (name/email/phone/destination/travelDate/travelerCount/notes)
  options        Json? // CONFIRM only — [{ label, nextStepId }]
  nextStepId     String?         @map("next_step_id") // COLLECT's "what comes next" (CONFIRM branches via options instead; CLOSING leaves this null)
  canvasX        Int?            @map("canvas_x")
  canvasY        Int?            @map("canvas_y")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flow         BotFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([flowId])
  @@map("bot_flow_steps")
}

/// Which flow is currently active for one connected channel (a WhatsApp
/// number OR an Instagram account) — one active flow per channel per org. Keyed
/// by (organizationId, channel) rather than a ChannelConnection id, matching
/// Phase 3's own convention (its disconnect endpoint is also channel-keyed,
/// since each org has at most one connection per channel today — see
/// ChannelConnection's own @@unique([organizationId, channel])). An org can
/// have many flows but only one live per channel at a time.
model BotFlowAssignment {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  channel        ConversationChannel
  flowId         String              @map("flow_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flow         BotFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@index([organizationId])
  @@map("bot_flow_assignments")
}

/// Tracks one conversation's live progress through its assigned BotFlow. The
/// poller (see queues/bot-flow-poller) advances this whenever a new inbound
/// message lands on a bot-assigned conversation, using `lastProcessedMessageAt`
/// as its cursor so each inbound message is handled exactly once.
model BotFlowSession {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  conversationId         String               @unique @map("conversation_id") @db.Uuid
  flowId                 String               @map("flow_id") @db.Uuid
  currentStepId          String?              @map("current_step_id") @db.Uuid
  collectedData          Json                 @default("{}") @map("collected_data")
  status                 BotFlowSessionStatus @default(ACTIVE)
  lastProcessedMessageAt DateTime?            @map("last_processed_message_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flow         BotFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bot_flow_sessions")
}

/// Per-organization AI Agent configuration — the persona/system prompt used by
/// Bot Flow's natural-language extraction, "Suggest Reply" and "Summarize",
/// plus the org's own Gemini API key (encrypted at rest — see lib/encryption.ts,
/// the same helper Phase 3 uses for channel credentials).
model AiAgentSettings {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  systemPrompt   String?  @map("system_prompt")
  agencyFacts    String?  @map("agency_facts")
  tone           String?  @default("Friendly, warm and professional")
  geminiApiKey   String?  @map("gemini_api_key") // AES-256-GCM encrypted; never serialized back to the client
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_agent_settings")
}

/// Per-organization follow-up automation config: nudge a lead if their status
/// hasn't changed and there's been no reply within `delayHours`.
model AutomationSettings {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  enabled        Boolean  @default(false)
  delayHours     Int      @default(48) @map("delay_hours")
  nudgeMessage   String?  @map("nudge_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("automation_settings")
}

/// Audit trail for follow-up nudges — one row per scheduled check, whether it
/// actually sent, was skipped (status changed / lead already replied), or
/// failed. `channel` is a plain string (not a shared enum) since it spans
/// Email/WhatsApp/Instagram independently of ChannelType/CommChannel.
model FollowUpAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  leadId         String         @map("lead_id") @db.Uuid
  channel        String
  scheduledFor   DateTime       @map("scheduled_for")
  status         FollowUpStatus @default(PENDING)
  reason         String?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId, createdAt])
  @@map("follow_up_attempts")
}

// ===========================================================================
// Email OTP signup verification
// ===========================================================================

/// A pending new-organization signup awaiting email OTP verification. No
/// `organizationId` — there is no organization yet. This sits at the same
/// pre-tenant tier as User/Organization/Invitation and is accessed ONLY via
/// systemPrisma (never withTenant), same reason those three are: RLS has
/// nothing to scope this to.
model SignupVerification {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique // the OTP target; one pending signup per email
  organizationName String   @map("organization_name")
  name             String
  passwordHash     String   @map("password_hash")
  otpHash          String   @map("otp_hash") // sha256, never the plain code
  attempts         Int      @default(0)
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("signup_verifications")
}

// ===========================================================================
// Platform administration (Super Admin panel — the CRM's own operator, not a
// tenant). Lives entirely outside the multi-tenant model: no organizationId,
// its own login surface (`/api/platform-admin`), its own JWT scope, and its
// own frontend (`/owner`) — never reachable through the tenant app's
// AuthContext or ProtectedRoute. Row Level Security is enabled on this table
// with NO policy (see the platform_admin migration), so the restricted
// `crm_app` role — the connection every ordinary tenant request runs as —
// gets zero access to it, full stop. Only the privileged systemPrisma
// connection (table owner, exempt from RLS) can ever read or write it.
// ===========================================================================

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("platform_admins")
}

/// Every mutating action taken from the Super Admin panel — suspend/reactivate
/// an org, disable/enable a user, create an org, add a note. Same RLS lockout
/// as PlatformAdmin (enabled, no policy — crm_app gets nothing). `organizationId`
/// is a plain unmodeled reference (raw FK in the migration, no Prisma relation)
/// so this stays fully decoupled from the Organization model — no back-relation
/// field, nothing a tenant-facing query could ever accidentally `include`.
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String?  @map("admin_id") @db.Uuid
  adminEmail  String   @map("admin_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  targetLabel String   @map("target_label")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Internal, owner-only notes about an organization (support/sales context —
/// "upgraded to annual", "flaky payments, watch this one"). Deliberately NEVER
/// visible to the organization itself: RLS is enabled with NO policy, so even
/// if a future tenant-facing route mistakenly queried this table, `crm_app`
/// would still get zero rows. `organizationId` is a plain unmodeled reference,
/// same reasoning as PlatformAuditLog above.
model OrganizationNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  adminId        String?  @map("admin_id") @db.Uuid
  adminEmail     String   @map("admin_email")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("organization_notes")
}

// ===========================================================================
// Owner-only finance tracking (manual — no payment gateway integration).
// Same RLS lockout as the other Super Admin tables above: enabled, no policy,
// so `crm_app` (every ordinary tenant request) gets zero rows, even for its
// own organization's subscription. `organizationId` is a plain unmodeled
// reference, same reasoning as OrganizationNote.
// ===========================================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// One row per organization — the owner manually sets what plan/price an
/// agency is on. There is no payment gateway; this is bookkeeping, not billing.
model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planName       String             @map("plan_name")
  amount         Int
  currency       String             @default("INR")
  status         SubscriptionStatus @default(ACTIVE)
  startedAt      DateTime           @map("started_at")
  renewsAt       DateTime?          @map("renews_at")
  notes          String?
  adminId        String?            @map("admin_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("organization_subscriptions")
}

enum ExpenseCategory {
  HOSTING
  API_COSTS
  SOFTWARE
  MARKETING
  PAYROLL
  OTHER
}

/// A manually-logged platform operating expense (VPS, API costs, tools…).
model PlatformExpense {
  id          String          @id @default(uuid()) @db.Uuid
  description String
  category    ExpenseCategory @default(OTHER)
  amount      Int
  currency    String          @default("INR")
  expenseDate DateTime        @map("expense_date")
  adminId     String?         @map("admin_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([expenseDate])
  @@map("platform_expenses")
}
