# ---------------------------------------------------------------------------
# Backend environment — copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on
PORT=4000

# Where the frontend runs (for CORS in dev). In production behind Nginx this is
# same-origin and can be left as the deployed URL.
CORS_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# DATABASE_URL: privileged/owner connection. Used for:
#   - Prisma migrations
#   - the NARROW auth surface (login lookup + signup transaction) via systemPrisma
#
# APP_DATABASE_URL: restricted runtime connection (role `crm_app`). Used by every
#   tenant request. Row Level Security is ENFORCED on this connection, so a
#   forgotten organization filter returns zero rows instead of leaking data.
#   If left blank, the app falls back to DATABASE_URL and logs a loud warning
#   that DB-level RLS is not being enforced (app-level scoping still applies).
#
# Local Postgres (after `npm run db:up` at the repo root):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"
APP_DATABASE_URL="postgresql://crm_app:crm_app_pw@localhost:5432/crm?schema=public"

# Supabase (production target) — from Project Settings → Database:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# APP_DATABASE_URL="postgresql://crm_app:[crm_app_password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# The password to assign the crm_app role when running `npm run db:roles`.
# Must match the password in APP_DATABASE_URL above.
CRM_APP_DB_PASSWORD="crm_app_pw"

# --- Auth -------------------------------------------------------------------
# Long random string. Generate one: `openssl rand -base64 48`
JWT_SECRET="change-me-in-production-use-a-64-char-random-string"
# Access token lifetime (jsonwebtoken format: 15m, 1h, 7d, ...)
JWT_EXPIRES_IN="7d"
# Cookie name for the session token
AUTH_COOKIE_NAME="crm_token"

# --- Phase 3: Communication (WhatsApp/Instagram/Email/Call Log) -------------
# ENCRYPTION_KEY encrypts every channel's stored credentials at rest (OAuth
# tokens from WhatsApp/Instagram Embedded Signup, the Email provider API key)
# — required once any organization connects a channel. Generate one:
#   openssl rand -hex 32
# ENCRYPTION_KEY=

# One Meta App (developer.facebook.com) is shared by the whole platform; each
# organization connects its OWN WhatsApp number / Instagram account via
# Embedded Signup — we only ever store THEIR resulting token, never a
# password. Leave blank to keep WhatsApp/Instagram connect disabled (Settings
# → Channels reports "not configured" instead of a dead button).
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=          # any random string you also paste into Meta's webhook setup
# META_GRAPH_VERSION=v21.0
# META_WHATSAPP_CONFIG_ID=            # Meta App Dashboard → WhatsApp → Embedded Signup → Configuration ID
# META_INSTAGRAM_APP_ID=              # usually same as META_APP_ID; separate only if you use a dedicated IG app
#
# Note: Email (Resend/SendGrid) has no OAuth equivalent — each organization
# enters its OWN API key directly in Settings → Channels (encrypted at rest
# with ENCRYPTION_KEY above). There is no global env var for this; a plain
# per-org API key field is correct here.

# --- Phase 4: Automation (Bot Flow poller + follow-up nudges) ---------------
# Redis backs the BullMQ workers. Leave blank to disable both features
# gracefully (the server still starts fine; automation endpoints report
# "not configured"). In docker-compose.prod.yml this MUST be
# redis://redis:6379 (the Compose service hostname, not localhost).
# REDIS_URL=redis://localhost:6379
#
# --- Signup OTP (Email) -------------------------------------------------------
# A PLATFORM-level Resend account (NOT a tenant's — there's no organization
# yet at signup time). Leave blank to disable OTP signup gracefully
# (POST /auth/signup/start reports 503 with a clear "not configured" message
# instead of crashing). Unlike WhatsApp, no pre-approval needed — works the
# moment you have a Resend account + a verified sending domain.
# PLATFORM_RESEND_API_KEY=
# PLATFORM_EMAIL_FROM_ADDRESS=noreply@youragency.com
#
# Note: the Gemini key for AI Agent Builder (Bot Flow's natural-language
# understanding, Suggest Reply, Summarize) is also per-organization — entered
# in Settings → AI Agent, encrypted at rest. No global env var for it either.

# --- Supabase Storage (image uploads) ---
# Create a PUBLIC bucket named "uploads" in Supabase → Storage, then set:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret from Project Settings → API>
# SUPABASE_STORAGE_BUCKET=uploads

# --- Google Gemini (AI package generation) — optional ---
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
